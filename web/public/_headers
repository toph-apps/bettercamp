# Fingerprinted assets: immutable, 1-year cache. Vite hashes catalog-*.db,
# sql-wasm-*.wasm, index-*.js, index-*.css so a new build invalidates safely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must revalidate so users pick up new asset URLs.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
